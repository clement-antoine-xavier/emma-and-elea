// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  role          String?
  banned        Boolean?     @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  // Domain relations (docs/ERD.md). Relation fields only; no domain data lives
  // on this model, so `npm run auth:generate` can regenerate it safely.
  recipeVersionsCreated    RecipeVersion[]
  purchaseReceiptsReceived PurchaseReceipt[]
  stockMovementsCreated    StockMovement[]
  costSnapshotsCreated     CostSnapshot[]
  wasteRecordsRecorded     WasteRecord[]
  absencesDecided          Absence[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy       String?
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  // Domain relations (docs/ERD.md). Relation fields only; no domain data lives
  // on this model, so `npm run auth:generate` can regenerate it safely.
  settings               OrganizationSetting?
  sites                  Site[]
  energyTariffs          EnergyTariff[]
  labourRates            LabourRate[]
  itemCategories         ItemCategory[]
  items                  Item[]
  itemAllergens          ItemAllergen[]
  suppliers              Supplier[]
  supplierItems          SupplierItem[]
  purchaseReceipts       PurchaseReceipt[]
  purchaseReceiptLines   PurchaseReceiptLine[]
  recipes                Recipe[]
  recipeVersions         RecipeVersion[]
  recipeLines            RecipeLine[]
  recipeOperations       RecipeOperation[]
  equipment              Equipment[]
  costSnapshots          CostSnapshot[]
  costSnapshotLines      CostSnapshotLine[]
  lots                   Lot[]
  stockMovements         StockMovement[]
  productionBatches      ProductionBatch[]
  productionBatchInputs  ProductionBatchInput[]
  productionBatchOutputs ProductionBatchOutput[]
  lossReasons            LossReason[]
  wasteRecords           WasteRecord[]
  salesDaily             SalesDaily[]

  // Phase 2
  productionPlans     ProductionPlan[]
  productionPlanLines ProductionPlanLine[]
  productionTasks     ProductionTask[]
  customers           Customer[]
  orders              Order[]
  orderLines          OrderLine[]
  dispatches          Dispatch[]
  dispatchLines       DispatchLine[]
  events              Event[]
  employeeProfiles    EmployeeProfile[]
  skills              Skill[]
  employeeSkills      EmployeeSkill[]
  availability        Availability[]
  absences            Absence[]
  shifts              Shift[]
  shiftAssignments    ShiftAssignment[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  employeeProfile EmployeeProfile?

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ---------------------------------------------------------------------------
// Domain — Phase 1
//
// See docs/ERD.md for the full model and docs/adr/0010-model-the-production-domain.md
// for the rationale. Phase 2 and 3 tables are intentionally absent:
// ProductionPlan, ProductionTask, Customer, Order, Dispatch, Event, team tables
// and stock counts.
//
// Two Phase 2 relations are therefore not declared yet and will arrive with
// those tables: ProductionBatch.productionPlanLineId and
// ProductionBatch.operatorId.
// ---------------------------------------------------------------------------

enum SiteKind {
  WORKSHOP
  SHOP
  WAREHOUSE
  LAB
}

enum EnergyKind {
  ELECTRICITY
  GAS
}

enum UnitKind {
  MASS
  VOLUME
  COUNT
  LENGTH
}

enum ItemType {
  RAW_MATERIAL
  PACKAGING
  SEMI_FINISHED
  FINISHED_PRODUCT
}

enum SalesChannel {
  RETAIL
  WHOLESALE
  BOTH
  NONE
}

enum AllergenPresence {
  CONTAINS
  MAY_CONTAIN
}

enum ReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum RecipeVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CostScope {
  RECIPE_VERSION
  PRODUCTION_BATCH
}

enum CostLineKind {
  MATERIAL
  PACKAGING
  LABOUR
  ENERGY
  OVERHEAD
}

enum LotStatus {
  AVAILABLE
  QUARANTINE
  CONSUMED
  EXPIRED
  DISCARDED
}

enum StockMovementType {
  RECEIPT
  CONSUMPTION
  PRODUCTION_OUTPUT
  DISPATCH
  WASTE
  TRANSFER
  ADJUSTMENT
  COUNT
}

enum StockReferenceType {
  PURCHASE_RECEIPT
  PRODUCTION_BATCH
  DISPATCH
  WASTE_RECORD
  STOCK_COUNT
  MANUAL
}

enum BatchStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LossCategory {
  OVERPRODUCTION
  EXPIRED
  BREAKAGE
  QUALITY
  TRIMMING
  STAFF_MEAL
  DONATION
  OTHER
}

enum SalesSource {
  MANUAL
  IMPORT
  POS
}

enum EquipmentKind {
  OVEN
  MIXER
  FRIDGE
  FREEZER
  PROOFER
  FRYER
  SCALE
  LABELLER
  OTHER
}

model Site {
  id             String       @id @default(cuid(2))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  kind           SiteKind     @default(WORKSHOP)
  addressLine1   String?
  addressLine2   String?
  postalCode     String?
  city           String?
  country        String       @default("FR")
  timezone       String       @default("Europe/Paris")
  isActive       Boolean      @default(true)
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  energyTariffs     EnergyTariff[]
  labourRates       LabourRate[]
  purchaseReceipts  PurchaseReceipt[]
  equipment         Equipment[]
  lots              Lot[]
  stockMovements    StockMovement[]
  productionBatches ProductionBatch[]
  costSnapshots     CostSnapshot[]
  wasteRecords      WasteRecord[]
  salesDaily        SalesDaily[]
  productionPlans   ProductionPlan[]
  orders            Order[]
  dispatches        Dispatch[]
  events            Event[]
  employeeProfiles  EmployeeProfile[]
  shifts            Shift[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("site")
}

model OrganizationSetting {
  id                   String       @id @default(cuid(2))
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currency             String       @default("EUR") @db.VarChar(3)
  overheadPct          Decimal      @default(10) @db.Decimal(5, 2)
  defaultLabourRateId  String?
  defaultLabourRate    LabourRate?  @relation(fields: [defaultLabourRateId], references: [id], onDelete: SetNull)
  forecastHistoryDays  Int          @default(56)
  forecastSafetyPct    Decimal      @default(5) @db.Decimal(5, 2)
  defaultShelfLifeDays Int?
  lotNumberPattern     String       @default("{site}-{yyMMdd}-{seq}")
  pricesIncludeVat     Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@map("organization_setting")
}

model EnergyTariff {
  id             String       @id @default(cuid(2))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId         String
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  energyKind     EnergyKind   @default(ELECTRICITY)
  pricePerKwh    Decimal      @db.Decimal(12, 4)
  currency       String       @default("EUR") @db.VarChar(3)
  validFrom      DateTime     @db.Date
  validTo        DateTime?    @db.Date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([siteId, energyKind, validFrom])
  @@index([organizationId])
  @@map("energy_tariff")
}

model LabourRate {
  id             String       @id @default(cuid(2))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId         String?
  site           Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  label          String
  hourlyCost     Decimal      @db.Decimal(12, 4)
  currency       String       @default("EUR") @db.VarChar(3)
  validFrom      DateTime     @db.Date
  validTo        DateTime?    @db.Date
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  settings         OrganizationSetting[]
  recipeOperations RecipeOperation[]

  @@index([organizationId, siteId, validFrom])
  @@map("labour_rate")
}

model Unit {
  id           String   @id @default(cuid(2))
  code         String   @unique
  labelEn      String
  labelFr      String
  pluralFr     String
  kind         UnitKind
  factorToBase Decimal  @db.Decimal(18, 8)
  isBase       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockItems             Item[]                  @relation("ItemStockUnit")
  saleItems              Item[]                  @relation("ItemSaleUnit")
  supplierItems          SupplierItem[]
  purchaseReceiptLines   PurchaseReceiptLine[]
  recipeVersions         RecipeVersion[]
  recipeLines            RecipeLine[]
  costSnapshots          CostSnapshot[]
  costSnapshotLines      CostSnapshotLine[]
  stockMovements         StockMovement[]
  productionBatchInputs  ProductionBatchInput[]
  productionBatchOutputs ProductionBatchOutput[]
  productionBatches      ProductionBatch[]
  productionPlanLines    ProductionPlanLine[]
  orderLines             OrderLine[]
  dispatchLines          DispatchLine[]
  wasteRecords           WasteRecord[]
  salesDaily             SalesDaily[]

  @@map("unit")
}

model Item {
  id               String        @id @default(cuid(2))
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         ItemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  code             String
  name             String
  description      String?
  type             ItemType
  stockUnitId      String
  stockUnit        Unit          @relation("ItemStockUnit", fields: [stockUnitId], references: [id])
  saleUnitId       String?
  saleUnit         Unit?         @relation("ItemSaleUnit", fields: [saleUnitId], references: [id], onDelete: SetNull)
  salePrice        Decimal?      @db.Decimal(12, 4)
  vatRate          Decimal       @default(5.50) @db.Decimal(5, 2)
  shelfLifeDays    Int?
  minStockQuantity Decimal?      @db.Decimal(14, 4)
  parLevelQuantity Decimal?      @db.Decimal(14, 4)
  defaultChannel   SalesChannel  @default(RETAIL)
  isPurchasable    Boolean       @default(false)
  isProduced       Boolean       @default(false)
  isSellable       Boolean       @default(false)
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  itemAllergens          ItemAllergen[]
  supplierItems          SupplierItem[]
  recipes                Recipe[]
  recipeLines            RecipeLine[]
  purchaseReceiptLines   PurchaseReceiptLine[]
  lots                   Lot[]
  stockMovements         StockMovement[]
  productionBatchInputs  ProductionBatchInput[]
  productionBatchOutputs ProductionBatchOutput[]
  costSnapshotLines      CostSnapshotLine[]
  wasteRecords           WasteRecord[]
  salesDaily             SalesDaily[]
  productionPlanLines    ProductionPlanLine[]
  orderLines             OrderLine[]
  dispatchLines          DispatchLine[]

  @@unique([organizationId, code])
  @@index([organizationId, type])
  @@index([organizationId, categoryId])
  @@map("item")
}

model ItemCategory {
  id             String         @id @default(cuid(2))
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         ItemCategory?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children       ItemCategory[] @relation("CategoryParent")
  name           String
  sortOrder      Int            @default(0)
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items Item[]

  @@unique([organizationId, parentId, name])
  @@index([organizationId])
  @@map("item_category")
}

model Allergen {
  id        String   @id @default(cuid(2))
  code      String   @unique
  labelEn   String
  labelFr   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itemAllergens ItemAllergen[]

  @@map("allergen")
}

model ItemAllergen {
  id             String           @id @default(cuid(2))
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  allergenId     String
  allergen       Allergen         @relation(fields: [allergenId], references: [id], onDelete: Restrict)
  presence       AllergenPresence @default(CONTAINS)
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([itemId, allergenId, presence])
  @@index([organizationId])
  @@index([allergenId])
  @@map("item_allergen")
}

model Supplier {
  id                  String       @id @default(cuid(2))
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                String
  name                String
  contactName         String?
  email               String?
  phone               String?
  addressLine1        String?
  postalCode          String?
  city                String?
  country             String       @default("FR")
  defaultLeadTimeDays Int?
  note                String?
  archivedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  items    SupplierItem[]
  receipts PurchaseReceipt[]

  @@unique([organizationId, code])
  @@map("supplier")
}

model SupplierItem {
  id               String       @id @default(cuid(2))
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId       String
  supplier         Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  itemId           String
  item             Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplierRef      String?
  packQuantity     Decimal      @db.Decimal(14, 4)
  packUnitId       String
  packUnit         Unit         @relation(fields: [packUnitId], references: [id])
  price            Decimal      @db.Decimal(12, 4)
  currency         String       @default("EUR") @db.VarChar(3)
  leadTimeDays     Int?
  minOrderQuantity Decimal?     @db.Decimal(14, 4)
  isPreferred      Boolean      @default(false)
  validFrom        DateTime     @db.Date
  validTo          DateTime?    @db.Date
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  receiptLines PurchaseReceiptLine[]

  @@unique([supplierId, itemId, validFrom])
  @@index([organizationId, itemId, isPreferred])
  @@map("supplier_item")
}

model PurchaseReceipt {
  id                String        @id @default(cuid(2))
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId            String
  site              Site          @relation(fields: [siteId], references: [id], onDelete: Restrict)
  supplierId        String
  supplier          Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  number            String
  supplierReference String?
  status            ReceiptStatus @default(DRAFT)
  receivedAt        DateTime?
  currency          String        @default("EUR") @db.VarChar(3)
  totalAmount       Decimal       @default(0) @db.Decimal(12, 4)
  note              String?
  receivedById      String?
  receivedBy        User?         @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  lines PurchaseReceiptLine[]

  @@unique([organizationId, number])
  @@index([siteId, receivedAt])
  @@index([supplierId])
  @@map("purchase_receipt")
}

model PurchaseReceiptLine {
  id                String          @id @default(cuid(2))
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseReceiptId String
  purchaseReceipt   PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  itemId            String
  item              Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  supplierItemId    String?
  supplierItem      SupplierItem?   @relation(fields: [supplierItemId], references: [id], onDelete: SetNull)
  quantity          Decimal         @db.Decimal(14, 4)
  unitId            String
  unit              Unit            @relation(fields: [unitId], references: [id])
  unitPrice         Decimal         @db.Decimal(12, 4)
  lineTotal         Decimal         @db.Decimal(12, 4)
  lotNumber         String?
  supplierLotNumber String?
  expiresOn         DateTime?       @db.Date
  bestBeforeOn      DateTime?       @db.Date
  note              String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  lot Lot?

  @@index([purchaseReceiptId])
  @@index([itemId])
  @@index([organizationId])
  @@map("purchase_receipt_line")
}

model Recipe {
  id               String         @id @default(cuid(2))
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outputItemId     String
  outputItem       Item           @relation(fields: [outputItemId], references: [id], onDelete: Restrict)
  currentVersionId String?        @unique
  currentVersion   RecipeVersion? @relation("RecipeCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  code             String
  name             String
  description      String?
  isDefault        Boolean        @default(true)
  archivedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  versions            RecipeVersion[]      @relation("RecipeVersions")
  productionPlanLines ProductionPlanLine[]

  @@unique([organizationId, code])
  @@index([organizationId, outputItemId, isDefault])
  @@map("recipe")
}

model RecipeVersion {
  id             String              @id @default(cuid(2))
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipeId       String
  recipe         Recipe              @relation("RecipeVersions", fields: [recipeId], references: [id], onDelete: Cascade)
  currentOf      Recipe?             @relation("RecipeCurrentVersion")
  versionNumber  Int
  status         RecipeVersionStatus @default(DRAFT)
  yieldQuantity  Decimal             @db.Decimal(14, 4)
  yieldUnitId    String
  yieldUnit      Unit                @relation(fields: [yieldUnitId], references: [id])
  portionCount   Int?
  prepMinutes    Int?
  cookMinutes    Int?
  instructions   String?
  changeNote     String?
  publishedAt    DateTime?
  createdById    String?
  createdBy      User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  lines             RecipeLine[]
  operations        RecipeOperation[]
  costSnapshots     CostSnapshot[]
  productionBatches ProductionBatch[]

  @@unique([recipeId, versionNumber])
  @@index([organizationId, status])
  @@map("recipe_version")
}

model RecipeLine {
  id              String        @id @default(cuid(2))
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipeVersionId String
  recipeVersion   RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity        Decimal       @db.Decimal(14, 4)
  unitId          String
  unit            Unit          @relation(fields: [unitId], references: [id])
  lossPct         Decimal       @default(0) @db.Decimal(5, 2)
  isOptional      Boolean       @default(false)
  position        Int           @default(0)
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([recipeVersionId, position])
  @@index([itemId])
  @@index([organizationId])
  @@map("recipe_line")
}

model RecipeOperation {
  id                String        @id @default(cuid(2))
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipeVersionId   String
  recipeVersion     RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  equipmentId       String?
  equipment         Equipment?    @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  labourRateId      String?
  labourRate        LabourRate?   @relation(fields: [labourRateId], references: [id], onDelete: SetNull)
  position          Int           @default(0)
  name              String
  description       String?
  durationMinutes   Int
  activeMinutes     Int?
  temperatureC      Decimal?      @db.Decimal(5, 2)
  estimatedQuantity Decimal?      @db.Decimal(14, 4)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  costSnapshotLines CostSnapshotLine[]

  @@unique([recipeVersionId, position])
  @@index([organizationId])
  @@map("recipe_operation")
}

model Equipment {
  id             String        @id @default(cuid(2))
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId         String?
  site           Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  name           String
  kind           EquipmentKind @default(OTHER)
  powerKw        Decimal?      @db.Decimal(8, 3)
  note           String?
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  operations RecipeOperation[]

  @@index([organizationId, siteId])
  @@map("equipment")
}

model CostSnapshot {
  id                String           @id @default(cuid(2))
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId            String?
  site              Site?            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  scope             CostScope
  recipeVersionId   String?
  recipeVersion     RecipeVersion?   @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  productionBatchId String?
  productionBatch   ProductionBatch? @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  computedAt        DateTime         @default(now())
  currency          String           @default("EUR") @db.VarChar(3)
  materialCost      Decimal          @db.Decimal(12, 4)
  packagingCost     Decimal          @db.Decimal(12, 4)
  labourCost        Decimal          @db.Decimal(12, 4)
  energyCost        Decimal          @db.Decimal(12, 4)
  overheadCost      Decimal          @db.Decimal(12, 4)
  totalCost         Decimal          @db.Decimal(12, 4)
  yieldQuantity     Decimal          @db.Decimal(14, 4)
  yieldUnitId       String
  yieldUnit         Unit             @relation(fields: [yieldUnitId], references: [id])
  costPerUnit       Decimal          @db.Decimal(12, 4)
  salePrice         Decimal?         @db.Decimal(12, 4)
  marginPct         Decimal?         @db.Decimal(5, 2)
  inputHash         String?
  createdById       String?
  createdBy         User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())

  lines CostSnapshotLine[]

  @@index([organizationId, recipeVersionId, computedAt])
  @@index([productionBatchId])
  @@map("cost_snapshot")
}

model CostSnapshotLine {
  id                String           @id @default(cuid(2))
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costSnapshotId    String
  costSnapshot      CostSnapshot     @relation(fields: [costSnapshotId], references: [id], onDelete: Cascade)
  kind              CostLineKind
  itemId            String?
  item              Item?            @relation(fields: [itemId], references: [id], onDelete: SetNull)
  lotId             String?
  lot               Lot?             @relation(fields: [lotId], references: [id], onDelete: SetNull)
  recipeOperationId String?
  recipeOperation   RecipeOperation? @relation(fields: [recipeOperationId], references: [id], onDelete: SetNull)
  label             String
  quantity          Decimal?         @db.Decimal(14, 4)
  unitId            String?
  unit              Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  unitCost          Decimal?         @db.Decimal(12, 4)
  amount            Decimal          @db.Decimal(12, 4)
  position          Int              @default(0)
  createdAt         DateTime         @default(now())

  @@index([costSnapshotId, kind, position])
  @@index([organizationId])
  @@map("cost_snapshot_line")
}

model Lot {
  id                    String               @id @default(cuid(2))
  organizationId        String
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId                String
  site                  Site                 @relation(fields: [siteId], references: [id], onDelete: Restrict)
  itemId                String
  item                  Item                 @relation(fields: [itemId], references: [id], onDelete: Restrict)
  purchaseReceiptLineId String?              @unique
  purchaseReceiptLine   PurchaseReceiptLine? @relation(fields: [purchaseReceiptLineId], references: [id], onDelete: SetNull)
  productionBatchId     String?
  productionBatch       ProductionBatch?     @relation(fields: [productionBatchId], references: [id], onDelete: SetNull)
  lotNumber             String
  supplierLotNumber     String?
  receivedAt            DateTime
  producedOn            DateTime?            @db.Date
  expiresOn             DateTime?            @db.Date
  bestBeforeOn          DateTime?            @db.Date
  quantityReceived      Decimal              @db.Decimal(14, 4)
  quantityRemaining     Decimal              @db.Decimal(14, 4)
  unitCost              Decimal              @db.Decimal(12, 4)
  currency              String               @default("EUR") @db.VarChar(3)
  status                LotStatus            @default(AVAILABLE)
  note                  String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  stockMovements    StockMovement[]
  batchInputs       ProductionBatchInput[]
  batchOutputs      ProductionBatchOutput[]
  costSnapshotLines CostSnapshotLine[]
  wasteRecords      WasteRecord[]
  dispatchLines     DispatchLine[]

  @@unique([organizationId, siteId, itemId, lotNumber])
  @@index([siteId, expiresOn])
  @@index([organizationId, itemId, status])
  @@map("lot")
}

model StockMovement {
  id             String              @id @default(cuid(2))
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId         String
  site           Site                @relation(fields: [siteId], references: [id], onDelete: Restrict)
  itemId         String
  item           Item                @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lotId          String?
  lot            Lot?                @relation(fields: [lotId], references: [id], onDelete: SetNull)
  type           StockMovementType
  quantity       Decimal             @db.Decimal(14, 4)
  unitId         String
  unit           Unit                @relation(fields: [unitId], references: [id])
  occurredAt     DateTime            @default(now())
  referenceType  StockReferenceType?
  referenceId    String?
  reason         String?
  createdById    String?
  createdBy      User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())

  @@index([organizationId, itemId, occurredAt])
  @@index([lotId, occurredAt])
  @@index([referenceType, referenceId])
  @@map("stock_movement")
}

model ProductionBatch {
  id                   String              @id @default(cuid(2))
  organizationId       String
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId               String
  site                 Site                @relation(fields: [siteId], references: [id], onDelete: Restrict)
  recipeVersionId      String
  recipeVersion        RecipeVersion       @relation(fields: [recipeVersionId], references: [id], onDelete: Restrict)
  productionPlanLineId String?             @unique
  productionPlanLine   ProductionPlanLine? @relation(fields: [productionPlanLineId], references: [id], onDelete: SetNull)
  operatorId           String?
  operator             EmployeeProfile?    @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  code                 String
  status               BatchStatus         @default(PLANNED)
  plannedQuantity      Decimal             @db.Decimal(14, 4)
  actualQuantity       Decimal?            @db.Decimal(14, 4)
  unitId               String
  unit                 Unit                @relation(fields: [unitId], references: [id])
  plannedStartAt       DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  producedOn           DateTime?           @db.Date
  note                 String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  inputs        ProductionBatchInput[]
  outputs       ProductionBatchOutput[]
  costSnapshots CostSnapshot[]
  lots          Lot[]
  wasteRecords  WasteRecord[]
  tasks         ProductionTask[]

  @@unique([organizationId, code])
  @@index([siteId, producedOn])
  @@index([recipeVersionId])
  @@map("production_batch")
}

model ProductionBatchInput {
  id                  String          @id @default(cuid(2))
  organizationId      String
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionBatchId   String
  productionBatch     ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  lotId               String
  lot                 Lot             @relation(fields: [lotId], references: [id], onDelete: Restrict)
  itemId              String
  item                Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity            Decimal         @db.Decimal(14, 4)
  theoreticalQuantity Decimal?        @db.Decimal(14, 4)
  unitId              String
  unit                Unit            @relation(fields: [unitId], references: [id])
  unitCost            Decimal         @db.Decimal(12, 4)
  note                String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([productionBatchId, lotId])
  @@index([lotId])
  @@index([organizationId])
  @@map("production_batch_input")
}

model ProductionBatchOutput {
  id                String          @id @default(cuid(2))
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionBatchId String
  productionBatch   ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  itemId            String
  item              Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lotId             String?
  lot               Lot?            @relation(fields: [lotId], references: [id], onDelete: SetNull)
  quantity          Decimal         @db.Decimal(14, 4)
  unitId            String
  unit              Unit            @relation(fields: [unitId], references: [id])
  isPrimary         Boolean         @default(false)
  costPerUnit       Decimal?        @db.Decimal(12, 4)
  note              String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([productionBatchId, lotId])
  @@index([lotId])
  @@index([organizationId])
  @@map("production_batch_output")
}

model LossReason {
  id             String       @id @default(cuid(2))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  labelFr        String
  labelEn        String?
  category       LossCategory @default(OTHER)
  isActive       Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  wasteRecords WasteRecord[]

  @@unique([organizationId, code])
  @@map("loss_reason")
}

model WasteRecord {
  id                String           @id @default(cuid(2))
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId            String
  site              Site             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  itemId            String
  item              Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lotId             String?
  lot               Lot?             @relation(fields: [lotId], references: [id], onDelete: SetNull)
  productionBatchId String?
  productionBatch   ProductionBatch? @relation(fields: [productionBatchId], references: [id], onDelete: SetNull)
  lossReasonId      String
  lossReason        LossReason       @relation(fields: [lossReasonId], references: [id], onDelete: Restrict)
  quantity          Decimal          @db.Decimal(14, 4)
  unitId            String
  unit              Unit             @relation(fields: [unitId], references: [id])
  costImpact        Decimal          @db.Decimal(12, 4)
  currency          String           @default("EUR") @db.VarChar(3)
  recordedAt        DateTime         @default(now())
  recordedById      String?
  recordedBy        User?            @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  note              String?
  archivedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([siteId, recordedAt])
  @@index([organizationId, lossReasonId, recordedAt])
  @@index([lotId])
  @@map("waste_record")
}

model SalesDaily {
  id             String       @id @default(cuid(2))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId         String
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  businessDate   DateTime     @db.Date
  channel        SalesChannel @default(RETAIL)
  quantitySold   Decimal      @db.Decimal(14, 4)
  unitId         String
  unit           Unit         @relation(fields: [unitId], references: [id])
  revenue        Decimal      @default(0) @db.Decimal(12, 4)
  currency       String       @default("EUR") @db.VarChar(3)
  source         SalesSource  @default(MANUAL)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([siteId, itemId, businessDate, channel])
  @@index([organizationId, businessDate])
  @@map("sales_daily")
}

// ---------------------------------------------------------------------------
// Domain — Phase 2
//
// Planning, the commercial chain (customers, orders, lot-linked dispatches),
// calendar events and the team. See docs/ERD.md.
// ---------------------------------------------------------------------------

enum PlanStatus {
  DRAFT
  CONFIRMED
  CLOSED
  CANCELLED
}

enum PlanSource {
  FORECAST
  ORDERS
  MANUAL
  MIXED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum CustomerType {
  BUSINESS
  INDIVIDUAL
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  READY
  DELIVERED
  CANCELLED
}

enum DispatchStatus {
  DRAFT
  DISPATCHED
  CANCELLED
}

enum EventKind {
  LOCAL_EVENT
  HOLIDAY
  SCHOOL_BREAK
  WEATHER
  OTHER
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum AbsenceKind {
  VACATION
  SICK
  TRAINING
  OTHER
}

enum AbsenceStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum ShiftKind {
  PRODUCTION
  SALES
  DELIVERY
  CLEANING
  OTHER
}

enum AssignmentStatus {
  PLANNED
  CONFIRMED
  ABSENT
}

model ProductionPlan {
  id             String       @id @default(cuid(2))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId         String
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  plannedFor     DateTime     @db.Date
  status         PlanStatus   @default(DRAFT)
  source         PlanSource   @default(MANUAL)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lines ProductionPlanLine[]

  @@index([siteId, plannedFor])
  @@index([organizationId, plannedFor])
  @@map("production_plan")
}

model ProductionPlanLine {
  id               String         @id @default(cuid(2))
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionPlanId String
  productionPlan   ProductionPlan @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  itemId           String
  item             Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  recipeId         String?
  recipe           Recipe?        @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  orderLineId      String?
  orderLine        OrderLine?     @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  plannedQuantity  Decimal        @db.Decimal(14, 4)
  unitId           String
  unit             Unit           @relation(fields: [unitId], references: [id])
  note             String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  batch ProductionBatch?

  @@unique([productionPlanId, itemId, orderLineId])
  @@index([organizationId])
  @@index([itemId])
  @@map("production_plan_line")
}

model ProductionTask {
  id                 String           @id @default(cuid(2))
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionBatchId  String?
  productionBatch    ProductionBatch? @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  requiredSkillId    String?
  requiredSkill      Skill?           @relation(fields: [requiredSkillId], references: [id], onDelete: SetNull)
  assignedEmployeeId String?
  assignedEmployee   EmployeeProfile? @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  title              String
  description        String?
  status             TaskStatus       @default(TODO)
  estimatedMinutes   Int?
  plannedStartAt     DateTime?
  plannedEndAt       DateTime?
  position           Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([organizationId, plannedStartAt])
  @@index([assignedEmployeeId, status])
  @@index([requiredSkillId])
  @@map("production_task")
}

model Customer {
  id             String       @id @default(cuid(2))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String?
  name           String
  type           CustomerType @default(BUSINESS)
  contactName    String?
  email          String?
  phone          String?
  addressLine1   String?
  postalCode     String?
  city           String?
  country        String       @default("FR")
  vatNumber      String?
  note           String?
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orders     Order[]
  dispatches Dispatch[]

  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@map("customer")
}

model Order {
  id             String       @id @default(cuid(2))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId         String
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  number         String
  status         OrderStatus  @default(DRAFT)
  requestedFor   DateTime     @db.Date
  currency       String       @default("EUR") @db.VarChar(3)
  totalAmount    Decimal      @default(0) @db.Decimal(12, 4)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lines      OrderLine[]
  dispatches Dispatch[]

  @@unique([organizationId, number])
  @@index([siteId, requestedFor, status])
  @@index([customerId])
  @@map("order")
}

model OrderLine {
  id                String       @id @default(cuid(2))
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderId           String
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId            String
  item              Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity          Decimal      @db.Decimal(14, 4)
  unitId            String
  unit              Unit         @relation(fields: [unitId], references: [id])
  unitPrice         Decimal      @db.Decimal(12, 4)
  fulfilledQuantity Decimal      @default(0) @db.Decimal(14, 4)
  note              String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  planLines ProductionPlanLine[]

  @@index([orderId])
  @@index([organizationId])
  @@map("order_line")
}

model Dispatch {
  id             String         @id @default(cuid(2))
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId         String
  site           Site           @relation(fields: [siteId], references: [id], onDelete: Restrict)
  customerId     String?
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId        String?
  order          Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  number         String
  status         DispatchStatus @default(DRAFT)
  dispatchedAt   DateTime?
  carrier        String?
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lines DispatchLine[]

  @@unique([organizationId, number])
  @@index([siteId, dispatchedAt])
  @@index([customerId])
  @@map("dispatch")
}

model DispatchLine {
  id             String       @id @default(cuid(2))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dispatchId     String
  dispatch       Dispatch     @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lotId          String
  lot            Lot          @relation(fields: [lotId], references: [id], onDelete: Restrict)
  quantity       Decimal      @db.Decimal(14, 4)
  unitId         String
  unit           Unit         @relation(fields: [unitId], references: [id])
  unitPrice      Decimal?     @db.Decimal(12, 4)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([lotId])
  @@index([organizationId])
  @@map("dispatch_line")
}

model Event {
  id                String       @id @default(cuid(2))
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId            String?
  site              Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  name              String
  kind              EventKind    @default(LOCAL_EVENT)
  startsOn          DateTime     @db.Date
  endsOn            DateTime     @db.Date
  expectedUpliftPct Decimal?     @db.Decimal(5, 2)
  note              String?
  archivedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId, startsOn, endsOn])
  @@map("event")
}

model EmployeeProfile {
  id                  String       @id @default(cuid(2))
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId            String       @unique
  member              Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  siteId              String?
  site                Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  jobTitle            String?
  weeklyContractHours Decimal?     @db.Decimal(5, 2)
  hiredOn             DateTime?    @db.Date
  color               String?
  isActive            Boolean      @default(true)
  archivedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  skills           EmployeeSkill[]
  availability     Availability[]
  absences         Absence[]
  shiftAssignments ShiftAssignment[]
  tasksAssigned    ProductionTask[]
  operatedBatches  ProductionBatch[]

  @@index([organizationId, isActive])
  @@map("employee_profile")
}

model Skill {
  id             String       @id @default(cuid(2))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employeeSkills EmployeeSkill[]
  tasks          ProductionTask[]

  @@unique([organizationId, code])
  @@map("skill")
}

model EmployeeSkill {
  id             String          @id @default(cuid(2))
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skillId        String
  skill          Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level          SkillLevel      @default(INTERMEDIATE)
  certifiedOn    DateTime?       @db.Date
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([employeeId, skillId])
  @@index([organizationId])
  @@map("employee_skill")
}

model Availability {
  id             String          @id @default(cuid(2))
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  weekday        Int
  startMinute    Int
  endMinute      Int
  validFrom      DateTime?       @db.Date
  validTo        DateTime?       @db.Date
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([employeeId, weekday, startMinute])
  @@index([organizationId])
  @@map("availability")
}

model Absence {
  id             String          @id @default(cuid(2))
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind           AbsenceKind     @default(OTHER)
  startsAt       DateTime
  endsAt         DateTime
  status         AbsenceStatus   @default(REQUESTED)
  decidedById    String?
  decidedBy      User?           @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  note           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([employeeId, startsAt, endsAt])
  @@index([organizationId])
  @@map("absence")
}

model Shift {
  id             String       @id @default(cuid(2))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId         String
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  startsAt       DateTime
  endsAt         DateTime
  kind           ShiftKind    @default(PRODUCTION)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignments ShiftAssignment[]

  @@index([siteId, startsAt])
  @@index([organizationId, startsAt])
  @@map("shift")
}

model ShiftAssignment {
  id             String           @id @default(cuid(2))
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shiftId        String
  shift          Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       EmployeeProfile  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role           String?
  status         AssignmentStatus @default(PLANNED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([shiftId, employeeId])
  @@index([employeeId, shiftId])
  @@index([organizationId])
  @@map("shift_assignment")
}
