# Copy this file to `.env` and fill in real values.
# Generate a secret with: openssl rand -base64 32

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/emma_and_elea?schema=public"
# Prisma Postgres on Vercel: DATABASE_URL is the direct endpoint used by
# `prisma migrate deploy`; DATABASE_URL_POOLED is the pooled endpoint used by
# the application at runtime. PRISMA_DATABASE_URL is an optional fallback.
# The Vercel integration sets all three.
# DATABASE_URL_POOLED=""
# PRISMA_DATABASE_URL=""
BETTER_AUTH_SECRET="replace-with-a-32-byte-base64-secret"
BETTER_AUTH_URL="http://localhost:3000"
# Public URL of the MCP endpoint and base URL of the REST API. Each is a token
# audience and must match what clients call. HTTPS outside local development.
MCP_RESOURCE_URL="http://localhost:3000/mcp"
API_RESOURCE_URL="http://localhost:3000/api"

# In-app assistants (Vercel AI SDK + AI Gateway).
# On Vercel, OIDC authenticates the Gateway automatically. Locally, either set
# AI_GATEWAY_API_KEY or run `vercel env pull`.
AI_GATEWAY_API_KEY=""
ASSISTANT_ENABLED="false"
# Gateway model ids use the `creator/model-name` format.
ASSISTANT_MODEL="openai/gpt-5.4"
# Optional per-persona overrides.
ASSISTANT_EMMA_MODEL=""
ASSISTANT_ELEA_MODEL=""
# Signs tool approvals so a forged client response cannot authorize a gated
# action. Required in production.
TOOL_APPROVAL_SECRET=""

# Keep prompt and tool-result telemetry out of third-party exporters unless
# explicitly enabled.
ASSISTANT_TELEMETRY_ENABLED="false"

# Guardrails.
ASSISTANT_MAX_TURNS="8"
ASSISTANT_MAX_OUTPUT_TOKENS="2048"
ASSISTANT_MAX_RUN_TOKENS="20000"
ASSISTANT_TIMEOUT_MS="270000"
ASSISTANT_DAILY_TOKEN_BUDGET="50000"
ASSISTANT_RETENTION_DAYS="30"

# Development only: deterministic model for the assistant E2E smoke test.
# Ignored in production builds.
# ASSISTANT_FAKE_MODEL="echo"

# Vercel Blob. On Vercel the store connection provides BLOB_STORE_ID and OIDC
# automatically; locally use a read-write token from `vercel env pull` or create
# one in the Blob store settings.
BLOB_READ_WRITE_TOKEN=""
# BLOB_STORE_ID=""
