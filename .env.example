# Copy this file to `.env` and fill in real values.
# Generate a secret with: openssl rand -base64 32

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/emma_and_elea?schema=public"
BETTER_AUTH_SECRET="replace-with-a-32-byte-base64-secret"
BETTER_AUTH_URL="http://localhost:3000"
# Public URL of the MCP endpoint and base URL of the REST API. Each is a token
# audience and must match what clients call. HTTPS outside local development.
MCP_RESOURCE_URL="http://localhost:3000/mcp"
API_RESOURCE_URL="http://localhost:3000/api"
