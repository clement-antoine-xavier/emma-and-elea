# Copy this file to `.env` and fill in real values.
# Generate a secret with: openssl rand -base64 32

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/emma_and_elea?schema=public"
BETTER_AUTH_SECRET="replace-with-a-32-byte-base64-secret"
BETTER_AUTH_URL="http://localhost:3000"
# Public URL of the MCP endpoint and base URL of the REST API. Each is a token
# audience and must match what clients call. HTTPS outside local development.
MCP_RESOURCE_URL="http://localhost:3000/mcp"
API_RESOURCE_URL="http://localhost:3000/api"

# AI assistant (OpenAI Agents SDK). Server-only — never prefix with NEXT_PUBLIC_.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY="replace-with-your-openai-api-key"
# Optional: OpenAI-compatible gateway base URL.
# OPENAI_BASE_URL=""

ASSISTANT_ENABLED="false"
ASSISTANT_MODEL="gpt-5.4"
# Optional per-persona overrides.
ASSISTANT_EMMA_MODEL=""
ASSISTANT_ELEA_MODEL=""

# Keep prompts and tool results out of OpenAI tracing unless explicitly enabled.
OPENAI_AGENTS_TRACING_DISABLED="1"

# Guardrails.
ASSISTANT_MAX_TURNS="8"
ASSISTANT_DAILY_TOKEN_BUDGET="50000"
ASSISTANT_RETENTION_DAYS="30"

# Development only: deterministic model for the assistant E2E smoke test.
# Ignored in production builds.
# ASSISTANT_FAKE_MODEL="echo"

# Force the provider API. Unset: Responses for api.openai.com, Chat Completions
# when OPENAI_BASE_URL points at another gateway.
# ASSISTANT_USE_RESPONSES="true"
