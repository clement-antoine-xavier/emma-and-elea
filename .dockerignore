# Dependencies (installed inside the image)
node_modules/
.pnpm-store/

# Next.js build output (generated by `next build`)
.next/
out/
build/
.vercel/

# Prisma generated client (regenerated by the prebuild hook)
src/generated/prisma/

# Local environment files. Never bake secrets into an image.
.env
.env*

# Version control and tooling
.git/
.gitignore
.gitattributes
.github/
.agents/
.claude/
.windsurf/
AGENTS.md
skills-lock.json

# Logs and caches
*.log
.cache/
.turbo/
*.tsbuildinfo

# Test artifacts
coverage/
playwright-report/
test-results/
blob-report/

# Editor and OS files
.vscode/
.idea/
.DS_Store
